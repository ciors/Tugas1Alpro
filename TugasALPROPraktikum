    "\n",
    "Program untuk pembuatan nama toko serta menghitung hasil Net"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e66c1d97",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "DorayakiDoraemonEnak\n",
      "Keuntungan total adalah 640000\n"
     ]
    }
   ],
   "source": [
    "# Meminta inputan dari user untuk dimasukkan ke setiap variabel nama yang diperlukan\n",
    "name1 = input(\"Masukkan nama makanan: \")\n",
    "name2 = input(\"Masukkan nama karakter: \")\n",
    "name3 = input(\"Masukkan kata sifat: \")\n",
    "\n",
    "# Menggabungkan semua variabel string dan print hasilnya\n",
    "final_name = name1 + name2 + name3\n",
    "print(final_name)\n",
    "\n",
    "# Memasukkan modal-modal yang dimiliki oleh Doraemon, Nobita, dan Shizuka\n",
    "modal_D = 555000\n",
    "modal_N = 333000\n",
    "modal_S = 222000\n",
    "\n",
    "# Menjumlahkan semua modal-modal yang ada\n",
    "total_modal = modal_D + modal_N + modal_S\n",
    "\n",
    "# Memasukkan informasi mengenai banyaknya dorayaki yang dijual beserta harga per dorayakinya\n",
    "jumlah_dorayaki = 350\n",
    "harga_dorayaki = 5000\n",
    "\n",
    "# Menghitung total pendapatan dari hasil penjualan dorayaki (Gross)\n",
    "total_pendapatan = jumlah_dorayaki * harga_dorayaki\n",
    "\n",
    "# Menghitung selisih pendapatan per bulan dengan modal awal (Net)\n",
    "keuntungan = total_pendapatan - total_modal\n",
    "\n",
    "# print(\"Keuntungan total adalah\" keuntungan)\n",
    "# seharusnya ada ', setelah string \"Keuntungan total adalah\" dan sebelum variabel \"keuntungan\"\n",
    "\n",
    "# Memperbaiki kesalahan yang dilakukan Nobita\n",
    "print(\"Keuntungan total adalah\", keuntungan)\n",
    "\n"
   ]
  }
